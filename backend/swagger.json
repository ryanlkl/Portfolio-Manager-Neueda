{
  "openapi": "3.0.0",
  "info": {
    "title": "Portfolio Manager API",
    "version": "1.0.0",
    "description": "API documentation for the Portfolio Manager backend."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "Portfolio": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "totalValue": { "type": "number" }
        }
      },
      "Stock": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "portfolioId": { "type": "string" },
          "ticker": { "type": "string" },
          "name": { "type": "string" },
          "quantity": { "type": "number" },
          "totalValue": { "type": "number" }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "portfolioId": { "type": "string" },
          "stockId": { "type": "string" },
          "type": { "type": "string", "enum": ["buy", "sell"] },
          "quantity": { "type": "number" },
          "purchasePrice": { "type": "number" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["name", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered" },
          "400": { "description": "Invalid input" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/accounts/me": {
      "get": {
        "summary": "Get current user account",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User account info" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/portfolio": {
      "get": {
        "summary": "Get all portfolios",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of portfolios" }
        }
      }
    },
    "/portfolio/{id}": {
      "get": {
        "summary": "Get a portfolio by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Portfolio details" },
          "404": { "description": "Portfolio not found" }
        }
      }
    },
    "/portfolio/{id}/assets/stocks": {
      "get": {
        "summary": "Get all stocks in a portfolio",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of stocks" }
        }
      },
      "post": {
        "summary": "Add a stock to a portfolio",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticker": { "type": "string" },
                  "name": { "type": "string" },
                  "quantity": { "type": "number" }
                },
                "required": ["ticker", "quantity"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Stock added" }
        }
      }
    },
    "/portfolio/{id}/assets/stocks/{stockId}": {
      "patch": {
        "summary": "Update a stock's quantity",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "stockId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": { "type": "number" }
                },
                "required": ["quantity"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Stock updated" },
          "404": { "description": "Stock not found" }
        }
      },
      "delete": {
        "summary": "Delete a stock from a portfolio",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "stockId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Stock deleted" },
          "404": { "description": "Stock not found" }
        }
      }
    },
    "/portfolio/{id}/transactions": {
      "get": {
        "summary": "Get all transactions for a portfolio",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of transactions" }
        }
      }
    },
    "/portfolio/{id}/transactions/stock/{stockId}": {
      "get": {
        "summary": "Get all transactions for a specific stock in a portfolio",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "stockId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of transactions for the stock" }
        }
      }
    },
    "/portfolio/{id}/history": {
      "get": {
        "summary": "Get portfolio value history",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Portfolio history" }
        }
      }
    }
  }
}